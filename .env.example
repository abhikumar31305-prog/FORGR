# FORGR Environment Configuration Template
# Copy this file to .env and update values for your deployment environment
# DO NOT commit .env to version control (it contains secrets)

# ════════════════════════════════════════════════════════════════
# DEPLOYMENT ENVIRONMENT
# ════════════════════════════════════════════════════════════════
FORGR_ENV=development
# Set to "production" to enforce strict security checks (PostgreSQL, HTTPS, Redis, SECRET_KEY length)
# Set to "development" or "staging" for relaxed configuration

# ════════════════════════════════════════════════════════════════
# DATABASE CONFIGURATION (PostgreSQL required for production)
# ════════════════════════════════════════════════════════════════
# Format: postgresql://user:password@host:port/database
# Example: postgresql://forgr:secure_password@localhost:5432/forgr_prod
FORGR_DATABASE_URL=sqlite:///./forgr.db

# Connection pool settings for production (PostgreSQL only)
FORGR_DB_POOL_SIZE=20
# Maximum number of connections to maintain in the pool

FORGR_DB_MAX_OVERFLOW=40
# Maximum overflow connections beyond pool_size when all are in use

FORGR_DB_POOL_RECYCLE=1800
# Recycle connections after 30 minutes (3600 seconds) to prevent connection timeout

# ════════════════════════════════════════════════════════════════
# SECURITY & SECRETS
# ════════════════════════════════════════════════════════════════
# CRITICAL: Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Must be at least 32 characters for production
FORGR_SECRET_KEY=your-secure-secret-key-minimum-32-characters-required

# Seed password for bootstrap accounts (change immediately after first login)
FORGR_SEED_PASSWORD=change-this-default-password-immediately

# ════════════════════════════════════════════════════════════════
# CORS & FRONTEND
# ════════════════════════════════════════════════════════════════
# Comma-separated list of allowed frontend origins
# Production: use exact HTTPS URLs, no wildcards
# Examples: https://app.example.com,https://app-staging.example.com
FORGR_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ════════════════════════════════════════════════════════════════
# REDIS (Required for production, optional for development)
# ════════════════════════════════════════════════════════════════
# Format: redis://user:password@host:port/db or rediss:// for TLS
# Leave empty for in-memory rate limiting (development only)
# Example: redis://default:password@localhost:6379/0
FORGR_REDIS_URL=

# ════════════════════════════════════════════════════════════════
# RATE LIMITING
# ════════════════════════════════════════════════════════════════
FORGR_RATE_LIMIT_PER_MINUTE=120
# Requests per minute per IP address

FORGR_MAX_REQUEST_BYTES=20971520
# Maximum request body size in bytes (default: 20MB)

# ════════════════════════════════════════════════════════════════
# FILE UPLOADS
# ════════════════════════════════════════════════════════════════
FORGR_UPLOADS_DIR=./backend/uploads
# Directory for storing uploaded resumes and files

FORGR_MAX_RESUME_SIZE_MB=10
# Maximum resume file size in megabytes

# ════════════════════════════════════════════════════════════════
# EMAIL & NOTIFICATIONS
# ════════════════════════════════════════════════════════════════
FORGR_NOTIFICATION_PROVIDER=log
# Options: "log" (development), "smtp", "sendgrid", "mailgun"

# SMTP settings (if FORGR_NOTIFICATION_PROVIDER=smtp)
FORGR_SMTP_HOST=
FORGR_SMTP_PORT=587
FORGR_SMTP_USER=
FORGR_SMTP_PASSWORD=
FORGR_SMTP_FROM=noreply@forgr.app

# SendGrid API key (if FORGR_NOTIFICATION_PROVIDER=sendgrid)
FORGR_SENDGRID_API_KEY=

# ════════════════════════════════════════════════════════════════
# LOGGING & MONITORING
# ════════════════════════════════════════════════════════════════
FORGR_LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

FORGR_LOG_FORMAT=json
# Options: "json" (structured), "text" (human-readable)

# Centralized logging endpoint (optional)
FORGR_LOG_ENDPOINT=
# Example: https://logs.example.com/api/logs

# ════════════════════════════════════════════════════════════════
# ML MODEL MANAGEMENT
# ════════════════════════════════════════════════════════════════
FORGR_MODEL_REGISTRY_PATH=./backend/ml/models
# Directory for versioned ML models

# ════════════════════════════════════════════════════════════════
# TESTING
# ════════════════════════════════════════════════════════════════
FORGR_TEST_PASSWORD=forgr-test-password
# Password for test accounts (CI/CD only)
