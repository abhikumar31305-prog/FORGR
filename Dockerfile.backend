# Multi-stage Dockerfile for FORGR Backend API
# Production-grade containerization with security best practices

# ════════════════════════════════════════════════════════════════
# Stage 1: Builder - Install dependencies
# ════════════════════════════════════════════════════════════════
FROM python:3.12-slim as builder

WORKDIR /build

# Install build dependencies and system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY backend/requirements.txt .
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# ════════════════════════════════════════════════════════════════
# Stage 2: Runtime - Minimal production image
# ════════════════════════════════════════════════════════════════
FROM python:3.12-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    FORGR_ENV=production

# Install runtime dependencies only
RUN apt-get update && apt-get install -y --no-install-recommends \
    postgresql-client \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for security
RUN useradd -m -u 1000 forgr_user

# Set working directory
WORKDIR /app

# Copy installed Python packages from builder
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy application code
COPY backend/ .
COPY alembic/ ../alembic/
COPY alembic.ini .

# Create necessary directories with proper permissions
RUN mkdir -p uploads/resumes logs && \
    chown -R forgr_user:forgr_user /app && \
    chmod -R 755 uploads logs

# Switch to non-root user
USER forgr_user

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Expose port
EXPOSE 8000

# Run migrations (if FORGR_RUN_MIGRATIONS=true) and start API
CMD ["sh", "-c", "if [ \"$FORGR_RUN_MIGRATIONS\" = \"true\" ]; then alembic upgrade head; fi && uvicorn main:app --host 0.0.0.0 --port 8000"]
