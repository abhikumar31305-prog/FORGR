# Multi-stage Dockerfile for FORGR Frontend
# Production-grade containerization with security best practices

# ════════════════════════════════════════════════════════════════
# Stage 1: Builder - Build the React application
# ════════════════════════════════════════════════════════════════
FROM node:22-alpine as builder

WORKDIR /build

ARG VITE_API_BASE_URL=https://api.example.com
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

# Copy package files
COPY frontend/package*.json ./

# Install dependencies
RUN npm ci --legacy-peer-deps

# Copy source code
COPY frontend/ .

# Build the application
RUN npm run build

# ════════════════════════════════════════════════════════════════
# Stage 2: Runtime - Serve with Nginx
# ════════════════════════════════════════════════════════════════
FROM nginx:alpine

# Copy nginx configuration
COPY frontend/nginx.conf /etc/nginx/nginx.conf
COPY frontend/default.conf /etc/nginx/conf.d/default.conf

# Create nginx user
RUN addgroup -g 1000 nginx_user && \
    adduser -u 1000 -G nginx_user -s /sbin/nologin nginx_user

# Copy built application from builder
COPY --from=builder --chown=1000:1000 /build/dist /usr/share/nginx/html

# Create necessary directories with proper permissions
RUN mkdir -p /var/log/nginx /var/cache/nginx && \
    chown -R 1000:1000 /var/log/nginx /var/cache/nginx /var/run && \
    chmod -R 755 /usr/share/nginx/html

# Nginx master runs as root to bind port 80 and drops worker privileges to nginx_user per nginx.conf

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:80/ || exit 1

# Expose port
EXPOSE 80

# Start Nginx
CMD ["nginx", "-g", "daemon off;"]
