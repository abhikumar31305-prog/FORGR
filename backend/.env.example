FORGR_ENV=production
FORGR_SECRET_KEY=generate-a-random-secret-at-least-32-characters
FORGR_DATABASE_URL=postgresql+psycopg://forgr_app:change-this@localhost:5432/forgr
FORGR_SEED_PASSWORD=set-a-unique-bootstrap-password
FORGR_CORS_ORIGINS=https://app.example.com
FORGR_MAX_REQUEST_BYTES=20971520
FORGR_RATE_LIMIT_PER_MINUTE=120
FORGR_REDIS_URL=redis://localhost:6379/0
FORGR_NOTIFICATION_PROVIDER=log
FORGR_ACCESS_TOKEN_EXPIRE_MINUTES=15
FORGR_REFRESH_TOKEN_EXPIRE_DAYS=7
